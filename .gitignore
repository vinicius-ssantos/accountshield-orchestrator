# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Build
target/

# jqwik's local failed-example replay cache (issue #53) -- machine-local run state, not source
.jqwik-database

# IDE
.idea/
*.iml

# Local-only self-review notes (findings are tracked as GitHub issues instead)
docs/reviews/

# Frontend (tracked source lives on integration/frontend-console; these are local
# dependency/build artifacts left on disk when switching to a branch that doesn't track them)
frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts
frontend/out/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/tsconfig.tsbuildinfo
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
