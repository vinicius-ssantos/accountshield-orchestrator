{
  "openapi": "3.1.0",
  "info": {
    "title": "AccountShield Orchestrator API",
    "version": "1.0.0",
    "description": "Versioned frontend contract snapshot generated from the published Springdoc API."
  },
  "paths": {
    "/api/v1/operator/decisions/investigate": {
      "post": {
        "operationId": "investigateDecision",
        "summary": "Retrieve one authorized privacy-minimized decision timeline and provenance view",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionTimelineRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision investigation timeline",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionTimelineResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/operator/decisions/search": {
      "post": {
        "operationId": "searchDecisionInvestigations",
        "summary": "Search the authorized privacy-minimized decision investigation read model",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision investigation page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionSearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/protection-decisions": {
      "post": {
        "operationId": "createProtectionDecision",
        "summary": "Evaluate an account-protection event",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProtectionDecisionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Protection decision created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProtectionDecisionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
