# Browser-visible, non-secret deployment label.
NEXT_PUBLIC_APP_ENV=local

# Server-only data mode. Preview and production must use live.
ACCOUNTSHIELD_DATA_SOURCE=fixtures

# Server-only backend origin. Never rename with NEXT_PUBLIC_.
ACCOUNTSHIELD_API_URL=http://localhost:8080

# Server-only BFF transport boundaries.
ACCOUNTSHIELD_BFF_TIMEOUT_MS=2000
ACCOUNTSHIELD_BFF_MAX_RESPONSE_BYTES=32768

# Server-only Web Vitals sampling rate from 0 to 1.
# Defaults to 1 outside production and 0.1 in production.
ACCOUNTSHIELD_WEB_VITALS_SAMPLE_RATE=1
